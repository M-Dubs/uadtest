<?xml version="1.0" encoding="UTF-8"?>
<YealinkIPPhoneTextScreen destroyOnExit="yes">
    <Title>XML Test</Title>
    <Text>If you can see this, XML works as a line key!</Text>

    <SoftKey index="1">
        <Label>Refresh</Label>
        <URI>SoftKey:Refresh</URI>
    </SoftKey>

    <SoftKey index="4">
        <Label>Exit</Label>
        <URI>SoftKey:Exit</URI>
    </SoftKey>
</YealinkIPPhoneTextScreen>
